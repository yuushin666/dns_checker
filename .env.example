# ============================================================
# dns-checker — настройки окружения
# Скопируйте в .env и заполните реальными значениями:
#   cp env.example .env
# ============================================================

# --- Тайминги ------------------------------------------------
# Секунда выравнивания проходов: цикл выполняется на границе
# Ч:М:SYNC_SEC (синхронизация нескольких контейнеров по времени)
SYNC_SEC=10
# Период основного цикла (частота проверок), сек
RETRY_PERIOD=60
# Watchdog на shell-команду (nslookup, ip), сек
WATCHDOG=25
# Таймаут HTTP-запросов уведомлений (SMS, Telegram), сек
TIMEOUT=15

# --- Мониторинг ----------------------------------------------
# Домены для проверки, через запятую (без пробелов)
DOMAINS=example.com,example.org
# Значение параметра timeout для nslookup:
NS_TIMEOUT=5
# Значение параметра retry для nslookup:
NS_RETRY=5
#
# Проверяемые DNS-серверы. На каждый сервер — один контейнер
# (сервис-блок в docker-compose.yml). Скрипт читает переменную
# SERVER из окружения своего контейнера, поэтому число контейнеров
# равно числу проверяемых серверов. Можно задать их адреса здесь
# и ссылаться из compose через ${SERVER1}, либо вписать напрямую
# в compose — оба способа равнозначны.
SERVER1=203.0.113.1
SERVER2=203.0.113.2
SERVER3=8.8.8.8

# --- Служебная сеть ------------------------------------------
# Подсеть служебного bridge dns_checker_svc. На интерфейс контейнера
# в этой сети смотрят Netwatcher'ы оборудования: линк поднят — сервер
# "up", опущен — "down". По состоянию этого же интерфейса скрипт
# хранит статус между проходами.
# SVC_IP* — статические IP контейнеров в этой сети. Для сервера
# без служебного интерфейса (как watch3 с 8.8.8.8) оставьте пусто —
# такой контейнер не подключается к svc, а уведомления работают
# без интерфейса: скрипт помнит статус сам.
# Физический интерфейс хоста для macvlan:
SVC_PARENT=ens192
# Подсеть и пул адресов служебной сети:
SVC_NET=10.53.0/24
SVC_IP1=10.53.0.11
SVC_IP2=10.53.0.12

# --- SMS ------------------------------------------------------
# Номера телефонов для SMS-оповещений, через запятую (без пробелов):
PHONES=XXXXXXXXXXX
# URL SMS-шлюза:
SMS_URL=http://sms-gateway.internal/sms.php

# --- Telegram -------------------------------------------------
# Хост Telegram API (дефолт менять не нужно):
TG_PROXY=api.telegram.org
# ID бота (получите у @BotFather):
BOT_ID=my_bot_id
# ID чата для уведомлений:
CHAT_ID=000000000

# --- Прочее ---------------------------------------------------
# Часовой пояс для таймстампов лога:
TZ=UTC
